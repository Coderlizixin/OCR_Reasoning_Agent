# ==============================
# 1. 大文件、模型权重与输出结果 (🚨 避免 Git Push 失败的关键)
# ==============================
# 忽略你所有的模型运行结果、图表和日志文件夹
outputs/
logs/
checkpoints/

# 忽略所有庞大的数据/模型权重文件后缀
*.pkl
*.bin
*.safetensors
*.h5
*.pt
*.pth
*.ckpt

# ==============================
# 2. IDE 与编辑器配置 (🚨 避免每次打开都提示修改)
# ==============================
# PyCharm 配置文件
.idea/
*.iml

# VS Code 配置文件 (如果以后会用)
.vscode/

# 操作系统自动生成的垃圾文件
.DS_Store
Thumbs.db

# ==============================
# 3. Python 运行缓存与虚拟环境
# ==============================
# Python 编译的缓存文件
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境文件夹 (千万不要把虚拟环境传上 GitHub)
venv/
env/
.venv/
miniconda/
anaconda3/

# ==============================
# 4. 隐私与密钥文件
# ==============================
# 包含 API Key 或本地密码的配置文件
.env
.env.*
*.pdf